# Copy this file to .env and fill your real values (DeepSeek / OpenAI-compatible endpoint).
# NOTE: .env.example is only a template committed to GitHub. Put your real API Key
#       only in the local .env (already excluded by .gitignore).

# LLM endpoint
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
# 模型池（可选，逗号分隔）：按顺序尝试，前一个失败/空内容自动切换到下一个
# 留空则只用 LLM_MODEL
MODEL_POOL=

# Evaluation
EVAL_DATASET=spider
EVAL_DB_ROOT=data/spider
