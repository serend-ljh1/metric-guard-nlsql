# Copy this file to .env and fill your real values (DeepSeek / OpenAI-compatible endpoint).
# NOTE: .env.example is only a template committed to GitHub. Put your real API Key
#       only in the local .env (already excluded by .gitignore).

# LLM endpoint
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
# 模型池（可选，逗号分隔）：按顺序尝试，前一个失败/空内容自动切换到下一个
# 留空则只用 LLM_MODEL
MODEL_POOL=

# Evaluation
EVAL_DATASET=spider
EVAL_DB_ROOT=data/spider

# ---- API 鉴权（生产必配）----
# 格式 "token:role"，逗号分隔。配置后 /api/query 必须带 X-API-Token 头，
# 且角色取自 token（请求体里的 role 无法提权）。
# 与"登录会话"的关系：登录签发的会话 token 优先级更高，静态 token 用于无需账号的部署。
SQLPA_API_TOKENS=
# 未配置 token 时使用的默认角色（最小权限，默认 analyst）
SQLPA_DEFAULT_ROLE=analyst

# ---- 登录会话（可选）----
# 引导管理员账号：设置后首次启动自动创建（否则不预置任何账号，避免默认口令风险）
SQLPA_BOOTSTRAP_ADMIN_USER=admin
SQLPA_BOOTSTRAP_ADMIN_PASSWORD=
# 登录会话有效期（秒，默认 43200 = 12h）
SQLPA_LOGIN_TTL=
# 端点限速：同一调用者每分钟上限（<=0 关闭；评测可置 0）
SQLPA_RATE_LIMIT_PER_MIN=
# 会话记忆 TTL（秒）/ 容量上限（条）
SQLPA_SESSION_TTL=
SQLPA_SESSION_MAX=

# ---- HITL 工单 SLA（可选）----
# 工单自登记起的处理时限（小时，默认 24）；超期由 sweep 置 escalated 并升级
SQLPA_HITL_SLA_HOURS=
# SLA 升级/催办的投递地址：设置后 sweep 会把升级摘要 JSON POST 到此 webhook
# （未设置则仅写本地 data/hitl_sla_outbox.jsonl，并显式返回"未投递"）
SQLPA_HITL_WEBHOOK=

# ---- SQLite 并发就绪（可选）----
# 日志模式（默认 WAL，多 worker 共享同一 data/app.db 时读不阻塞写、写不阻塞读）
# 个别文件系统（网络盘/部分容器卷）不支持 WAL 时可改回 DELETE
SQLPA_SQLITE_JOURNAL_MODE=
# 写锁等待毫秒数（默认 5000），避免并发写直接抛 "database is locked"
SQLPA_SQLITE_BUSY_TIMEOUT_MS=

# ---- 指标中心写入目标（可选）----
# 指标中心写接口（/api/metrics/*）默认落回权威 business_config.yaml；
# 设置为另一路径可隔离写入（测试/多环境用）
SQLPA_METRIC_CONFIG_PATH=

# ---- Spider 数据位置（可选，避免写死机器路径）----
SQLPA_SPIDER_ROOT=

# ---- 评测可复现性（可选）----
# 置 0 可关闭路由的 LLM 二次判断兜底，使路由完全确定性
SQLPA_ROUTE_LLM_FALLBACK=
