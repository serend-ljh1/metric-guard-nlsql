# Copy this file to .env and fill your real values (DeepSeek / OpenAI-compatible endpoint).
# NOTE: .env.example is only a template committed to GitHub. Put your real API Key
#       only in the local .env (already excluded by .gitignore).

# LLM endpoint
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
# 模型池（可选，逗号分隔）：按顺序尝试，前一个失败/空内容自动切换到下一个
# 留空则只用 LLM_MODEL
MODEL_POOL=

# Evaluation
EVAL_DATASET=spider
EVAL_DB_ROOT=data/spider

# ---- API 鉴权（生产必配）----
# 格式 "token:role"，逗号分隔。配置后 /api/query 必须带 X-API-Token 头，
# 且角色取自 token（请求体里的 role 无法提权）。
SQLPA_API_TOKENS=
# 未配置 token 时使用的默认角色（最小权限，默认 analyst）
SQLPA_DEFAULT_ROLE=analyst

# ---- Spider 数据位置（可选，避免写死机器路径）----
SQLPA_SPIDER_ROOT=

# ---- 评测可复现性（可选）----
# 置 0 可关闭路由的 LLM 二次判断兜底，使路由完全确定性
SQLPA_ROUTE_LLM_FALLBACK=
