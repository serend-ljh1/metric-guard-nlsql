# 虚拟环境
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---- 前端（web/ 源码要进仓库，依赖与构建产物不进）----
node_modules/
web/dist/
.vite/

# ---- 密钥（绝不提交）----
.env
.env.local
.env.*.local
.env.bak
.env.*.bak
*.bak

# ---- 下载的真实数据集（体量大，不进仓库）----
data/spider/
data/bird/
data/olist/
data/downloads/
data/*.zip
data/*.tar.gz

# ---- 个人文档（不上传）----
docs/面试准备.md

# ---- 运行产物 ----
eval_result*.json
.pytest_tmp/
.tmp/
.tmppytest*/
.pyt/
._test_tmp/
# 调试遗留（点下划线前缀的临时产物，勿提交）
._*/
._*.txt
# 临时探针脚本（我调试时生成的一次性脚本）
_*.py
.pytest_cache/
data/business_audit.jsonl
data/hitl_queue.jsonl
data/demo_hitl.jsonl
data/datasources.yaml
data/.datasource_key
data/olist_sample/
data/app.db
data/reports/
data/subscriptions.json
*.log

# ---- 评测逐题产物（**随仓库发布**）----
# README 引用的 EX/token/成本数字只有靠这些逐题 JSON 才能被复核；
# 去掉它们，"数字可复核"就只是口号。合计约 220KB。
# 注意：不能用"先忽略整个目录再豁免文件"的写法（git 不会进入被忽略的目录），
# 且例外规则必须放在上面 `*.log` 等宽规则之后才生效。
!eval_results/
!eval_results/*.json
!eval_results/*.log
!eval_results/*.md

# ---- IDE ----
.idea/
.vscode/
