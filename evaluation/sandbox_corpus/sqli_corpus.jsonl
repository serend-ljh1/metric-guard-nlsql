{"id": "ro-08", "family": "readonly_baseline", "intent": "readonly", "expect": "allow", "payload": "SELECT DATE(order_purchase_timestamp) d, COUNT(*) n FROM orders GROUP BY d ORDER BY d DESC LIMIT 7", "source": "时间分组只读查询"}
