{"id": "ro-01", "family": "readonly_baseline", "intent": "readonly", "expect": "allow", "payload": "SELECT COUNT(*) FROM order_items", "source": "普通只读查询（对照组）"}
{"id": "ro-02", "family": "readonly_baseline", "intent": "readonly", "expect": "allow", "payload": "SELECT c.customer_state, SUM(oi.price) AS gmv FROM orders o JOIN order_items oi ON o.order_id=oi.order_id JOIN customers c ON o.customer_id=c.customer_id WHERE o.order_status!='canceled' GROUP BY c.customer_state ORDER BY gmv DESC LIMIT 5", "source": "业务主路径同构查询（对照组）"}
{"id": "ro-03", "family": "readonly_baseline", "intent": "readonly", "expect": "allow", "payload": "WITH x AS (SELECT order_id FROM orders WHERE order_status='delivered') SELECT COUNT(*) FROM x", "source": "CTE 只读（对照组）"}
{"id": "ro-04", "family": "readonly_baseline", "intent": "readonly", "expect": "allow", "payload": "SELECT SUM(oi.price) AS gmv FROM orders o JOIN order_items oi ON o.order_id=oi.order_id WHERE o.order_status != 'canceled' AND o.customer_id IN (SELECT customer_id FROM customers WHERE customer_state='SP')", "source": "子查询只读（对照组）"}
{"id": "ro-05", "family": "readonly_baseline", "intent": "readonly", "expect": "allow", "payload": "SELECT 'DROP TABLE x' AS note", "source": "**字符串字面量里含高危词**的合法只读查询：用于测误杀"}
{"id": "ro-06", "family": "readonly_baseline", "intent": "readonly", "expect": "allow", "payload": "SELECT order_id FROM orders WHERE order_status = 'delivered' LIMIT 10", "source": "带字面量条件的只读查询"}
